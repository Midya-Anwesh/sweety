NODE_ENV=development
PORT=3000
# Create these two databases separately; tests never use DATABASE_URL for cleanup.
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/sweety
TEST_DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/sweety_test
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_own_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
# Leave 0 locally. Set only to the exact number of trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0
