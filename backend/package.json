{
  "name": "@workspace/sweety-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sweety blood glucose tracker API",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run test:config && npm run build && vitest run",
    "test:config": "node --test tests/test-database.config.test.cjs",
    "test:watch": "npm run test:config && npm run build && vitest",
    "migration:run": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:generate": "node -e \"require('dotenv').config(); require('child_process').execSync('npx typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts src/database/migrations/' + process.argv[1], { stdio: 'inherit' })\"",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
